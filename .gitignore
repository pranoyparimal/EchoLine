# ==========================================
# Echo Line — Unity 6 LTS .gitignore
# Android · URP · Solo Developer
# ==========================================


# ------------------------------------------
# UNITY GENERATED — never commit these
# ------------------------------------------

# Asset import cache — rebuilds automatically on open
# Committing this bloats the repo by gigabytes
/[Ll]ibrary/

# Temporary Unity editor files
/[Tt]emp/

# Build output — binaries don't belong in source control
/[Bb]uilds/
/[Bb]uild/

# Unity editor and build logs
/[Ll]ogs/

# User Settings — machine-specific editor preferences and layouts
/[Uu]ser[Ss]ettings/


# ------------------------------------------
# UNITY EDITOR ARTIFACTS
# ------------------------------------------

# Unity autogenerated VS/Rider solution files
# These regenerate from .csproj — commit the .csproj, not these
*.sln
*.csproj

# Unity crash handler
/obj/

# Unity cache for shader variants (rebuilds on import)
/UserSettings/Layouts/
/UserSettings/Search/

# Unity 6 specific — asset pipeline v2 artifact cache
/AssetStoreTools/


# ------------------------------------------
# ANDROID BUILD ARTIFACTS
# ------------------------------------------

# Android keystore — NEVER commit this
# Losing your keystore = losing your Play Store listing permanently
*.keystore
*.jks

# Android Gradle build output
/Gradle/
/gradle/
*.apk
*.aab

# Android SDK auto-generated files
/AndroidPlayer/


# ------------------------------------------
# VISUAL STUDIO / RIDER / VSCODE
# ------------------------------------------

# VS Code workspace settings (machine-specific)
.vscode/

# JetBrains Rider
.idea/
*.DotSettings.user

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates


# ------------------------------------------
# OS GENERATED — cross-platform hygiene
# ------------------------------------------

# macOS Finder metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows thumbnail cache
Thumbs.db
ehthumbs.db
Desktop.ini

# Windows shortcut files
*.lnk


# ------------------------------------------
# UNITY CRASH REPORTS & ANALYTICS
# ------------------------------------------

# Unity Cloud Diagnostics / crash uploads
/Diagnostics/

# Unity Analytics local cache
sysinfo.txt
*.stackdump


# ------------------------------------------
# SOURCE ASSETS — optional but recommended
# ------------------------------------------

# Compressed source files (keep originals in cloud storage, not git)
# Uncomment if your raw assets are large PSDs / AIs / FBXs
# *.psd
# *.ai
# *.fbx


# ------------------------------------------
# WHAT IS COMMITTED (for clarity)
# ------------------------------------------
# /Assets/          — all your scripts, prefabs, scenes, materials
# /ProjectSettings/ — all project settings including URP config
# /Packages/        — manifest.json and packages-lock.json only
# .gitignore        — this file
# README.md         — if you create one
